1. Para todos los encabezados, lo imprima en el formato
"Organismo <el nombre del fasta>, contig <el contenido del encabezado, sin el ">""

import os

# Nombre del archivo FASTA
archivo = "vitiligo_homosapiens.fasta"

# Obtener el nombre del archivo sin la extensión
organismo = os.path.splitext(os.path.basename(archivo))[0]

# Leer el archivo FASTA
with open(archivo, "r") as fasta:

    for linea in fasta:

        # Identificar los encabezados
        if linea.startswith(">"):

            # Eliminar el símbolo > y espacios adicionales
            encabezado = linea[1:].strip()

            # Imprimir en el formato solicitado
            print(f"Organismo {organismo}, contig {encabezado}")


